datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  articles Article[]
}

model Article {
  id        Int      @id @default(autoincrement())
  judul     String
  isi       String
  lengkap   String
  penulisId Int
  penulis   User     @relation(fields: [penulisId], references: [id])
  createdAt DateTime @default(now())
}